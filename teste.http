# ======================================================================
# 8. CONCORRENCIA - OPCIONAL, EXECUCAO MANUAL SEPARADA
# ======================================================================


# Requisicoes sequenciais NAO comprovam seguranca de vendas simultaneas.
# Execute o cadastro abaixo; depois envie A e B ao mesmo tempo por dois clientes
# ou um disparador paralelo, usando exatamente o ID desse cadastro.
# Esperado: uma venda 200 e outra 400, nunca duas 200; estoque final 0.
# Nao reenvie o cadastro entre A e B. Para repetir, crie outra planta.
# Para testar exclusao concorrente: em uma nova rodada, dispare PATCH ou venda
# junto com DELETE. Conforme a ordem, a operacao pode concluir antes da exclusao
# (200) ou encontrar registro ausente (404); nao deve gerar 500 ou 200 com null.
# O DELETE bem-sucedido retorna 204. Esse cenario exige orquestracao externa.


### Preparar ultimo vaso para concorrencia - 201
# @name criarConcorrencia
POST {{baseUrl}}/plantas
Content-Type: application/json

{
  "nome": "Concorrencia - teste HTTP",
  "especie": "Nephrolepis exaltata",
  "preco": 4000,
  "estoque": 1,
  "luminosidade": "MEIA_SOMBRA",
  "petFriendly": true,
  "regaACadaDias": 3
}


### Venda concorrente A - 200 ou 400 conforme disputa
POST {{baseUrl}}/plantas/{{criarConcorrencia.response.body.$.id}}/venda
Content-Type: application/json

{
  "quantidade": 1
}


### Venda concorrente B - 200 ou 400 conforme disputa
POST {{baseUrl}}/plantas/{{criarConcorrencia.response.body.$.id}}/venda
Content-Type: application/json

{
  "quantidade": 1
}


### Conferir apos ambas as vendas - 200; estoque 0
GET {{baseUrl}}/plantas/{{criarConcorrencia.response.body.$.id}}


### Limpar registro de concorrencia depois da conferencia - 204
DELETE {{baseUrl}}/plantas/{{criarConcorrencia.response.body.$.id}}

