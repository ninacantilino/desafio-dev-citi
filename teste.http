# ======================================================================
# 2. LISTAGEM E FILTROS
# ======================================================================


### Listagem geral - 200, array incluindo os tres cadastros
GET {{baseUrl}}/plantas


### Filtro luminosidade=SOMBRA - 200; todos os resultados devem respeita-lo
GET {{baseUrl}}/plantas?luminosidade=SOMBRA


### Filtro luminosidade=MEIA_SOMBRA - 200; todos os resultados devem respeita-lo
GET {{baseUrl}}/plantas?luminosidade=MEIA_SOMBRA


### Filtro luminosidade=SOL_PLENO - 200; todos os resultados devem respeita-lo
GET {{baseUrl}}/plantas?luminosidade=SOL_PLENO


### Filtro petFriendly=true - 200; todos os resultados devem respeita-lo
GET {{baseUrl}}/plantas?petFriendly=true


### Filtro petFriendly=false - 200; todos os resultados devem respeita-lo
GET {{baseUrl}}/plantas?petFriendly=false


### Filtro luminosidade=SOMBRA&petFriendly=true - 200; todos os resultados devem respeita-lo
GET {{baseUrl}}/plantas?luminosidade=SOMBRA&petFriendly=true


### Filtro luminosidade=SOL_PLENO&petFriendly=false - 200; todos os resultados devem respeita-lo
GET {{baseUrl}}/plantas?luminosidade=SOL_PLENO&petFriendly=false


### Filtro invalido luminosidade=LUA - 400
GET {{baseUrl}}/plantas?luminosidade=LUA


### Filtro invalido luminosidade=sombra - 400
GET {{baseUrl}}/plantas?luminosidade=sombra


### Filtro invalido luminosidade= - 400
GET {{baseUrl}}/plantas?luminosidade=


### Filtro invalido petFriendly=banana - 400
GET {{baseUrl}}/plantas?petFriendly=banana


### Filtro invalido petFriendly=0 - 400
GET {{baseUrl}}/plantas?petFriendly=0


### Filtro invalido petFriendly= - 400
GET {{baseUrl}}/plantas?petFriendly=


### Filtro invalido petFriendly=null - 400
GET {{baseUrl}}/plantas?petFriendly=null


### Filtro invalido petFriendly=true&petFriendly=false - 400
GET {{baseUrl}}/plantas?petFriendly=true&petFriendly=false


### Filtro invalido luminosidade=SOMBRA&luminosidade=SOL_PLENO - 400
GET {{baseUrl}}/plantas?luminosidade=SOMBRA&luminosidade=SOL_PLENO


### Filtro invalido luminosidade=SOMBRA&petFriendly=banana - 400
GET {{baseUrl}}/plantas?luminosidade=SOMBRA&petFriendly=banana


# ======================================================================
# 3. BUSCA POR ID
# ======================================================================


### Buscar cadastro principal - 200; estoque 10, preco 4000
GET {{baseUrl}}/plantas/{{criarPlanta.response.body.$.id}}


### ID invalido abc - 400
GET {{baseUrl}}/plantas/abc


### ID invalido 0 - 400
GET {{baseUrl}}/plantas/0


### ID invalido -1 - 400
GET {{baseUrl}}/plantas/-1


### ID invalido 1.5 - 400
GET {{baseUrl}}/plantas/1.5


### ID invalido 2147483648 - 400
GET {{baseUrl}}/plantas/2147483648


### ID invalido 9007199254740992 - 400
GET {{baseUrl}}/plantas/9007199254740992


# IDs inexistentes sao testados apos a exclusao controlada, na secao 7.


# ======================================================================
# 4. EDICAO PARCIAL
# ======================================================================


### Alterar somente preco - 200; demais campos preservados
PATCH {{baseUrl}}/plantas/{{criarPlanta.response.body.$.id}}
Content-Type: application/json

{
  "preco": 5500
}


### Confirmar preco 5500 e estoque ainda 10 - 200
GET {{baseUrl}}/plantas/{{criarPlanta.response.body.$.id}}


### PATCH vazio - 200; nenhum campo de negocio muda
PATCH {{baseUrl}}/plantas/{{criarPlanta.response.body.$.id}}
Content-Type: application/json

{}


### Alterar somente petFriendly para false - 200
PATCH {{baseUrl}}/plantas/{{criarPlanta.response.body.$.id}}
Content-Type: application/json

{
  "petFriendly": false
}


### Estoque zero e limites minimos - 200
PATCH {{baseUrl}}/plantas/{{criarEsgotada.response.body.$.id}}
Content-Type: application/json

{
  "estoque": 0,
  "preco": 1,
  "regaACadaDias": 1
}


### Limite superior PostgreSQL, um campo por vez no registro esgotado - 200
PATCH {{baseUrl}}/plantas/{{criarEsgotada.response.body.$.id}}
Content-Type: application/json

{
  "preco": 2147483647,
  "regaACadaDias": 2147483647
}


### Restaurar preco e rega antes dos totais - 200
PATCH {{baseUrl}}/plantas/{{criarEsgotada.response.body.$.id}}
Content-Type: application/json

{
  "preco": 1,
  "regaACadaDias": 1
}


### Limite superior de estoque - 200
PATCH {{baseUrl}}/plantas/{{criarEsgotada.response.body.$.id}}
Content-Type: application/json

{
  "estoque": 2147483647
}


### Restaurar estoque zero antes das vendas e totais - 200
PATCH {{baseUrl}}/plantas/{{criarEsgotada.response.body.$.id}}
Content-Type: application/json

{
  "estoque": 0
}


