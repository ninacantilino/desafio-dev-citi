  "nome": "Violeta - teste HTTP",
  "especie": "Saintpaulia ionantha",
  "preco": 2500,
  "estoque": 8,
  "luminosidade": "SOMBRA",
  "petFriendly": true,
  "regaACadaDias": 3
}


